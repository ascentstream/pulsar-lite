FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY rust/target/release/pulsar-lite /app/pulsar-lite
COPY rust/pulsar-lite.toml /app/pulsar-lite.toml

ARG HOST_UID=1000
ARG HOST_GID=1000
RUN groupadd -g ${HOST_GID} broker \
    && useradd -u ${HOST_UID} -g ${HOST_GID} -m -d /home/broker broker \
    && chown -R ${HOST_UID}:${HOST_GID} /app /work 2>/dev/null || true

EXPOSE 6651 6652

CMD ["/app/pulsar-lite"]
